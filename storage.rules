rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "jafor100khan@gmail.com" || 
        request.auth.token.email == "mstkarimabibi45@gmail.com" ||
        request.auth.token.email == "sreemithunchandra021@gmail.com" ||
        request.auth.token.email_verified == true && (
          request.auth.token.email.matches(".*admin.*") || 
          request.auth.token.email == "mstkarimabibi45@gmail.com"
        )
      );
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
